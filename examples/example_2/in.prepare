# Preparation of the end-linking system (LAMMPS 30 Sep 2026 or newer, MOLECULE package).
# Relaxes the configuration packed by rw_pack, equilibrates it in the large box and compresses
# it to the target number density. Bead-spring model: shifted Lennard-Jones beads (cutoff 2.5)
# and harmonic bonds (K = 1000, r0 = 1).
#
#   lmp -in in.prepare -var data config.lmp      (in the directory written by rw_pack)
#
# Writes prepare/after_min.lmp, prepare/after_pre.lmp and prepare/after_decomp.lmp.

variable        data index config.lmp            # data file written by rw_pack
variable        seed index 241205                # random seed for velocities and thermostat
variable        relax_steps index 10000          # capped-displacement relaxation
variable        pre_steps index 100000           # equilibration in the packing box
variable        compress_steps index 500000      # compression to ref_rho
variable        ref_t equal 1.0
variable        ref_rho equal 0.85

units           lj
atom_style      molecular
boundary        p p p
read_data       ${data}

bond_style      harmonic
bond_coeff      1 1000.0 1.0
special_bonds   lj 0.0 1.0 1.0

pair_style      lj/cut 2.5
pair_modify     shift yes
pair_coeff      * * 1.0 1.0 2.5

timestep        0.005
shell           mkdir prepare

#------------------------------------------------------------#
# Relaxation of the lattice configuration
#------------------------------------------------------------#
fix             relax all nve/limit 0.1
thermo          1000
run             ${relax_steps}
write_data      prepare/after_min.lmp nocoeff
unfix           relax

#------------------------------------------------------------#
# Equilibration at the packing density
#------------------------------------------------------------#
reset_timestep  0
velocity        all create ${ref_t} ${seed} mom yes rot no
fix             1 all nve
fix             2 all langevin ${ref_t} ${ref_t} 10.0 $(v_seed+1)
thermo_style    custom step lx press temp
run             ${pre_steps}
write_data      prepare/after_pre.lmp nocoeff
unfix           2
unfix           1

#------------------------------------------------------------#
# Compression to the target number density
#------------------------------------------------------------#
variable        ref_l equal (atoms/v_ref_rho)^(1.0/3.0)
thermo_style    custom step lx temp press
thermo_modify   norm yes flush yes

reset_timestep  0
velocity        all create ${ref_t} $(v_seed+2) mom yes rot no
fix             1 all nve
fix             2 all langevin ${ref_t} ${ref_t} 10.0 $(v_seed+3)
fix             compress all deform 1 x final 0.0 ${ref_l} y final 0.0 ${ref_l} z final 0.0 ${ref_l} units box
run             ${compress_steps}
write_data      prepare/after_decomp.lmp nocoeff
unfix           compress
unfix           2
unfix           1

print           "preparation done: box edge $(lx:%.4f), number density $(atoms/vol:%.4f)"
